# ═══════════════════════════════════════════════════════
# CONFIGURACIÓN - Backend Telemetría FS25
# Copia este archivo a .env y ajusta los valores
# ═══════════════════════════════════════════════════════

# Environment
NODE_ENV=development

# WebSocket / Socket.io
SOCKET_IO_PORT=8080
SOCKET_IO_NAMESPACE=/telemetry
CORS_ORIGIN=http://localhost:8080
# Solo local por defecto. Usa HOST=0.0.0.0 para permitir otros equipos de la red
HOST=127.0.0.1

# Named Pipe (SHTelemetry.lua) — solo el nombre; el backend añade \\.\pipe\
NAMED_PIPE_NAME=SHTelemetry

# Configuración de Datos
UPDATE_FREQUENCY_MS=33
MAX_BUFFER_SIZE=1000
